#!/usr/bin/env bash
# Runs in the remote pod. The status line of a beam session, when the user's
# own status line is unset or its command doesn't exist in the pod.
#
# Reads Claude's status line JSON on stdin and prints one line:
#   ☁ beam INSTANCE │ MODEL │ DIR (BRANCH) │ N% context
# BEAM_INSTANCE comes from the pod's environment.
set -uo pipefail

IFS=$'\x1f' read -r model dir pct < <(jq -r '[
    .model.display_name // "?",
    .workspace.current_dir // .cwd // "",
    (.context_window.used_percentage // 0 | floor)
  ] | map(tostring) | join("\u001f")')
branch=$([ -n "$dir" ] && git -C "$dir" branch --show-current 2>/dev/null)
printf '☁ beam %s │ %s │ %s%s │ %s%% context\n' \
  "${BEAM_INSTANCE:-?}" "$model" "${dir/#$HOME/\~}" "${branch:+ ($branch)}" "$pct"
